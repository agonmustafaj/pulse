# Optional — free key from https://api.nasa.gov/
NASA_API_KEY=

# Optional — https://newsapi.org/ (RSS works without this)
NEWS_API_KEY=

# Optional Redis URL for shared cache (defaults to in-memory)
REDIS_URL=

# Comma-separated CORS origins (* for local/dev)
CORS_ORIGINS=*

# Host/port when running uvicorn directly
HOST=0.0.0.0
PORT=8000
